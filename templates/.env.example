# Copy to .env. Never commit .env.

# --- Agent model (leave unset in CI; deterministic tests must not call a model) ---
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5

# --- Eval judge: default is local Ollama (zero cost, offline) ---
# macOS: install natively (`brew install ollama && brew services start ollama`).
# A containerised Ollama gets no GPU on macOS and is much slower.
# Linux/CI: `docker compose --profile evals up -d ollama` is fine.
EVAL_JUDGE_PROVIDER=ollama          # ollama | anthropic
EVAL_JUDGE_MODEL=llama3.1:8b        # e.g. qwen2.5:7b ; if anthropic, use a small model like claude-haiku-4-5-20251001
OLLAMA_HOST=http://localhost:11434
# If EVAL_JUDGE_PROVIDER=anthropic, every `make eval` run costs money. Set intentionally.
# Judge model size matters: very small models (<=1B) produce unreliable verdicts.
# Always record judge-vs-human agreement in evals/judge_alignment.md before trusting scores.

# --- Observability ---
OTEL_GENAI_CAPTURE_CONTENT=false    # true only in a safe env; still redacts known PII
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
TRACE_LOG_DIR=logs/traces

# --- Data stores (filled in per discovery spec) ---
# DATABASE_URL=postgresql://...
# VECTOR_DB_URL=...
